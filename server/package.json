{
  "name": "hometeacher-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "test": "npm run build && tsx --test tests/book-reference-media.test.ts tests/book-index-cost.test.ts tests/runtime-paths.test.ts tests/server-smoke.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "2.21.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "firebase-admin": "13.10.0",
    "stripe": "20.4.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.19.0",
    "esbuild": "0.28.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
