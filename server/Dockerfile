# Build context: generated by npm run prepare:server in .cloud-run.
FROM node:20-slim AS build
WORKDIR /workspace/app/server
COPY app/server/package.json app/server/package-lock.json ./
RUN npm ci
COPY app/server/src ./src
COPY app/server/tsconfig.json ./
COPY app/shared /workspace/app/shared
COPY home-teacher-common /workspace/home-teacher-common
RUN npm run build
RUN npm prune --omit=dev

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=build /workspace/app/server/package.json ./
COPY --from=build /workspace/app/server/node_modules ./node_modules
COPY --from=build /workspace/app/server/dist ./dist
USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]
