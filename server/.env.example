# Local API only. Environment variables supplied by Cloud Run take precedence.
PORT=3003
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional authentication and billing settings.
# Relative credential paths are resolved from server/, then the legacy app root.
FIREBASE_SERVICE_ACCOUNT=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
